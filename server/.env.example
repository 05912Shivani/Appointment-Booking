NODE_ENV=development
PORT=5000

# Must point to a replica-set-enabled MongoDB (a MongoDB Atlas free cluster
# satisfies this) since the booking hold/confirm flow uses transactions.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/appointment-booking?retryWrites=true&w=majority&appName=Cluster0

JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CLIENT_ORIGIN=http://localhost:5173

SLOT_HOLD_MINUTES=5
SLOT_GENERATION_WEEKS=4

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@appointment-booking.local
